{
  "uid": "historical-analytics-overview",
  "title": "Historical Analytics Overview",
  "tags": ["iot", "historical", "analytics"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "kWh 30-day Trend",
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUX_HOT}"
      },
      "targets": [
        {
          "query": "from(bucket: v.defaultBucket) |> range(start: -30d) |> filter(fn: (r) => r._measurement == \"meter_readings\" and r._field == \"kWh\") |> aggregateWindow(every: 15m, fn: mean, createEmpty: false)"
        }
      ],
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      }
    }
  ]
}
